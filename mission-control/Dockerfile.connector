FROM python:3.12-slim@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217

ARG AEGIS_COMMIT=unknown
LABEL org.opencontainers.image.revision="$AEGIS_COMMIT"
WORKDIR /connector
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN DEBIAN_FRONTEND=noninteractive apt-get update \
    && apt-get upgrade --yes --no-install-recommends \
    && apt-get install --yes --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system aegis \
    && useradd --system --gid aegis --home-dir /connector aegis

COPY aegis_connector/ ./aegis_connector/
RUN chown -R aegis:aegis /connector

USER aegis
ENTRYPOINT ["python", "-m", "aegis_connector"]
