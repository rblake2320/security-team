[Unit]
Description=AEGIS Mission Control isolated restore drill
Requires=docker.service
After=docker.service network-online.target aegis-backup.service

[Service]
Type=oneshot
User=aegis-deploy
Group=aegis-deploy
SupplementaryGroups=docker
WorkingDirectory=/opt/aegis/current/deploy/vps
Environment=DOCKER_CONFIG=/tmp
ExecStart=/usr/libexec/docker/cli-plugins/docker-compose --env-file .env.production -f compose.production.yml --profile maintenance run --rm -e RESTORE_DRILL_DATABASE=aegis_monthly_restore_drill restore-drill
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/aegis
