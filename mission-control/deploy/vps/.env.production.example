AEGIS_ENV=production
AEGIS_WORKERS=2
AEGIS_IMAGE_TAG=2026.08.30
AUTH_MODE=cloudflare
DATABASE_ADMIN_URL=postgresql+psycopg://aegis:URL_ENCODED_ADMIN_PASSWORD@db:5432/aegis
AEGIS_DB_RUNTIME_PASSWORD=GENERATE_A_DIFFERENT_LONG_UNIQUE_PASSWORD
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=GENERATE_A_LONG_UNIQUE_PASSWORD
TOKEN_PEPPER=GENERATE_A_DIFFERENT_32_PLUS_CHARACTER_SECRET
EVIDENCE_MASTER_KEY=GENERATE_WITH_OPENSSL_RAND_BASE64_32_AND_MAKE_URL_SAFE
EVIDENCE_SCANNER_MODE=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
BOOTSTRAP_EMAIL=owner@your-domain.example
BOOTSTRAP_ORGANIZATION=Your Mission Control
BOOTSTRAP_SLUG=your-workspace
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=YOUR_ACCESS_APPLICATION_AUD
PUBLIC_HOSTNAME=mission.your-domain.example
CLOUDFLARE_TUNNEL_TOKEN=YOUR_DEDICATED_TUNNEL_TOKEN
MAX_EVENT_BATCH=100
MAX_EVIDENCE_BYTES=10485760
TASK_LEASE_SECONDS=120
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
FORWARDED_ALLOW_IPS=*
