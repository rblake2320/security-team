AEGIS_ENV=production
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8780
AUTH_MODE=cloudflare
DATABASE_URL=postgresql+psycopg://aegis:CHANGE_ME@db:5432/aegis
EVIDENCE_ROOT=/var/lib/aegis/evidence
EVIDENCE_MASTER_KEY=GENERATE_WITH_OPENSSL_RAND_BASE64_32_AND_MAKE_URL_SAFE
TOKEN_PEPPER=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
BOOTSTRAP_EMAIL=owner@example.com
BOOTSTRAP_ORGANIZATION=Example Mission Control
BOOTSTRAP_SLUG=example
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=YOUR_ACCESS_APPLICATION_AUD
PUBLIC_HOSTNAME=mission.your-domain.example
MAX_EVENT_BATCH=100
MAX_EVIDENCE_BYTES=10485760
TASK_LEASE_SECONDS=120
