# AEGIS customer-edge connector. Store real values in the operating-system
# secret manager or service environment; do not commit a populated copy.
AEGIS_API_URL=https://mission.example.com
AEGIS_CONNECTOR_TOKEN=aegc_replace_with_one_time_credential
AEGIS_PROGRAM_ROOT=C:\path\to\security-team
AEGIS_ALLOWED_ROOTS=C:\path\to\authorized-repository
AEGIS_ALLOWED_HOSTS=staging.example.com,api.staging.example.com

# Required only when the human application is protected by a more-specific
# Cloudflare Access service-auth policy for connector routes.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

AEGIS_POLL_SECONDS=10
AEGIS_REQUEST_TIMEOUT_SECONDS=30
AEGIS_TASK_TIMEOUT_SECONDS=840
AEGIS_MAX_EVIDENCE_BYTES=10485760
