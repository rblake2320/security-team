{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aegis-purple/exercise-plan/1.0",
  "title": "Aegis Purple frozen exercise plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "exercise_id", "version", "title", "owner", "environment", "expires_at", "authorization_receipt_sha256", "readiness_snapshot_sha256", "rubric_sha256", "role_trust_sha256", "test_cases", "stop_conditions"],
  "properties": {
    "schema": {"const": "aegis.purple.exercise-plan/1.0"},
    "exercise_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
    "version": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "owner": {"type": "string", "minLength": 1, "maxLength": 120},
    "environment": {"enum": ["lab", "dev", "pre-prod", "prod"]},
    "expires_at": {"type": "string", "format": "date-time"},
    "authorization_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "readiness_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rubric_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "role_trust_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stop_conditions": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_case_id", "technique", "procedure_sha256", "expected_telemetry", "expected_detections", "safety_class", "rollback_verified", "observe_only"],
        "properties": {
          "test_case_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
          "technique": {"type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"},
          "procedure_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "expected_telemetry": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
          "expected_detections": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
          "safety_class": {"enum": ["low", "medium", "high"]},
          "rollback_verified": {"type": "boolean"},
          "observe_only": {"type": "boolean"}
        }
      }
    }
  }
}
